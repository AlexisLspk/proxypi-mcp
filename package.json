{
  "name": "proxypi",
  "version": "1.0.0",
  "description": "Self-healing API proxy MCP — your API calls, but they never actually break.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src/banner.txt"
  ],
  "bin": {
    "proxypi": "dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "NODE_OPTIONS='--no-deprecation' tsx src/index.ts",
    "start": "node --no-deprecation dist/index.js",
    "test": "npm run build && node --test --import tsx \"src/__tests__/*.test.ts\""
  },
  "keywords": [
    "mcp",
    "proxy",
    "api",
    "self-healing",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexisLspk/proxypi-mcp.git"
  },
  "homepage": "https://github.com/AlexisLspk/proxypi-mcp#readme",
  "bugs": {
    "url": "https://github.com/AlexisLspk/proxypi-mcp/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "nock": "^14.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
